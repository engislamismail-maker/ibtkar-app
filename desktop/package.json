{
  "name": "ibtkar-desktop",
  "productName": "Ibtkar",
  "version": "1.0.0",
  "description": "إبتكار — نسخة الكمبيوتر",
  "author": "IBTKAR Architecture Development",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.ibtkar.app",
    "productName": "Ibtkar",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "www/**/*"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ibtkar",
      "artifactName": "ibtkar-setup.exe"
    }
  }
}
