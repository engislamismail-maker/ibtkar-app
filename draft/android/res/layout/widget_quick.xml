<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="8dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="إبتكار · تسجيل سريع 🔒"
        android:textColor="#FFD59663"
        android:textSize="11sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="4dp"
        android:layoutDirection="rtl"
        android:orientation="horizontal">
    <LinearLayout
        android:id="@+id/w_expense"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_circle_rose"
            android:gravity="center"
            android:text="➖"
            android:textSize="19sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="مصروف"
            android:textColor="#FFF5F1EC"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_income"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_circle_sage"
            android:gravity="center"
            android:text="💰"
            android:textSize="19sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="قبض"
            android:textColor="#FFF5F1EC"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_voice"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_circle_gold"
            android:gravity="center"
            android:text="🎙️"
            android:textSize="19sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="حسابات بالصوت"
            android:textColor="#FFF5F1EC"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_note"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_circle_cream"
            android:gravity="center"
            android:text="📝"
            android:textSize="19sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="ملاحظة بالصوت"
            android:textColor="#FFF5F1EC"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/w_work_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/widget_row_bg"
            android:layoutDirection="rtl"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👷 شغالين النهارده:"
                android:textColor="#FFD59663"
                android:textSize="11.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_work"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="—"
                android:textColor="#FFF5F1EC"
                android:textSize="11.5sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_last_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/widget_row_bg"
            android:layoutDirection="rtl"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧾 آخر عملية:"
                android:textColor="#FFD59663"
                android:textSize="11.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_last"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="—"
                android:textColor="#FFF5F1EC"
                android:textSize="11.5sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_due_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/widget_row_bg"
            android:layoutDirection="rtl"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 مستحق النهارده:"
                android:textColor="#FFD59663"
                android:textSize="11.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_due"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="—"
                android:textColor="#FFF5F1EC"
                android:textSize="11.5sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_at"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="افتح البرنامج مرة عشان الأرقام تظهر"
            android:textColor="#99F5F1EC"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
